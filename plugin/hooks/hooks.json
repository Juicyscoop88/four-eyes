{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && \"${CLAUDE_PLUGIN_ROOT}/bin/foureyes\" hook session-start", "timeout": 120 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && \"${CLAUDE_PLUGIN_ROOT}/bin/foureyes\" hook pre-tool-use" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && \"${CLAUDE_PLUGIN_ROOT}/bin/foureyes\" hook stop", "timeout": 120 }] }
    ]
  }
}
